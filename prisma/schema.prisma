
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  DOCTOR
  NURSE
  PATIENT
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String     

  role       Role

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}